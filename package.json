{
  "name": "tachsync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:live": "node scripts/android-live.mjs",
    "android:emulator": "node scripts/android-live.mjs --emulator-only",
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "cd android && set \"JAVA_HOME=C:\\Program Files\\Android\\Android Studio\\jbr\" && .\\gradlew.bat assembleDebug",
    "android:install": "npm run android:sync && npm run android:apk && adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "predev": "node scripts/sync-rive-wasm.mjs",
    "prebuild": "node scripts/sync-rive-wasm.mjs",
    "pretest": "node scripts/sync-rive-wasm.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@rive-app/canvas": "^2.39.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.0.5",
    "sass": "^1.102.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
